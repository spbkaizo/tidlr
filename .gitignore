# Build output (the compiled binary at the repo root, and release artifacts).
# NOTE: keep these anchored/specific so they do not match the cmd/tidlr source
# package directory.
/tidlr
/dist/
/tidlr-*

# Local configuration (may contain machine-specific paths; not for the repo)
/config.toml

# State & data (queue DB, downloaded audio, tokens) — never in the repo
*.db
*.db-shm
*.db-wal
/downloads/
auth.json

# Editor / tooling / local session data
/.claude/
/.idea/
/.vscode/

# Internal planning notes (not shared)
/PLAN.md

# OS cruft
.DS_Store
Thumbs.db
